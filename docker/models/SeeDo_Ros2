# syntax=docker/dockerfile:1

ARG BASE_IMAGE=ur_robotiq_teleoperation:latest
FROM ${BASE_IMAGE}

ARG SAM_REPOSITORY="https://github.com/facebookresearch/segment-anything.git"
ARG SAM_COMMIT="dca509fe793f601edb92606367a655c15ac00fdf"

ARG SAM2_REPOSITORY="https://github.com/facebookresearch/segment-anything-2.git"
ARG SAM2_COMMIT="2b90b9f5ceec907a1c18123530e92e794ad901a4"

LABEL org.opencontainers.image.title="SeeDo ROS 2 CUDA 13"
LABEL org.opencontainers.image.description="ROS 2 Jazzy, UR5e, Robotiq and SeeDo with CUDA 13 for NVIDIA GB10"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SEEDO_ROOT=/opt/models/SeeDo \
    GROUNDING_DINO_ROOT=/opt/models/GroundingDINO \
    SAM_ROOT=/opt/models/segment-anything \
    SAM2_ROOT=/opt/models/segment-anything-2 \
    SEEDO_CHECKPOINTS=/opt/checkpoints/seedo \
    SEEDO_VENV=/opt/seedo-venv \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all

USER root

# Installa versioni CUDA 13.0 coerenti e impedisce ad APT di scegliere
# una vecchia versione di cuBLAS rimasta disponibile nel repository.
RUN apt-get update \
    && apt-get install -y \
        --allow-change-held-packages \
        --no-install-recommends \
        libcublas-13-0=13.1.1.3-1 \
        libcublas-dev-13-0=13.1.1.3-1 \
        cuda-toolkit-13-0=13.0.3-1 \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --set cuda /usr/local/cuda-13.0

ENV CUDA_HOME=/usr/local/cuda-13.0
ENV PATH="/usr/local/cuda-13.0/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda-13.0/lib64:/opt/seedo-venv/lib/python3.12/site-packages/torch/lib"
ENV USE_TF=0 \
    TRANSFORMERS_NO_TF=1

RUN nvcc --version \
    && test "$(readlink -f /usr/local/cuda)" = "/usr/local/cuda-13.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        python3-dev \
        python3-venv \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-vision-msgs \
    && rm -rf /var/lib/apt/lists/*

# Dedicated SeeDo environment. It can still see ROS/global packages, but
# packages installed here take precedence.
RUN python3 -m venv --system-site-packages "${SEEDO_VENV}" \
    && "${SEEDO_VENV}/bin/python" -m pip install --upgrade \
        "pip<25" \
        setuptools==79.0.1 \
        wheel

ENV PATH="${SEEDO_VENV}/bin:${PATH}"

RUN python -m pip install \
        --upgrade \
        --force-reinstall \
        --timeout 300 \
        --retries 10 \
        torch==2.13.0 \
        torchvision==0.28.0 \
        --index-url https://download.pytorch.org/whl/cu130

RUN python - <<'PY'
import torch

print("PyTorch:", torch.__version__)
print("PyTorch CUDA build:", torch.version.cuda)

if torch.version.cuda is None or not torch.version.cuda.startswith("13."):
    raise RuntimeError(
        f"Expected a CUDA 13 PyTorch wheel, found: {torch.version.cuda}"
    )
PY

RUN mkdir -p \
        /opt/models \
        "${SEEDO_CHECKPOINTS}"

COPY ai_controller/ai_controller/models/seedo_controller/models/SeeDo/ "${SEEDO_ROOT}/"
COPY ai_controller/ai_controller/models/seedo_controller/models/GroundingDINO/ "${GROUNDING_DINO_ROOT}/"
COPY ai_controller/ai_controller/models/seedo_controller/models/seedo/ "${SEEDO_CHECKPOINTS}/"

RUN git clone "${SAM_REPOSITORY}" "${SAM_ROOT}" \
    && git -C "${SAM_ROOT}" checkout --detach "${SAM_COMMIT}" \
    && test "$(git -C "${SAM_ROOT}" rev-parse HEAD)" = "${SAM_COMMIT}" \
    && git clone "${SAM2_REPOSITORY}" "${SAM2_ROOT}" \
    && git -C "${SAM2_ROOT}" checkout --detach "${SAM2_COMMIT}" \
    && test "$(git -C "${SAM2_ROOT}" rev-parse HEAD)" = "${SAM2_COMMIT}"

RUN test -d "${SEEDO_ROOT}" \
    && test -d "${GROUNDING_DINO_ROOT}" \
    && test -f "${SEEDO_ROOT}/requirements.txt"

# Keep the CUDA 13 PyTorch stack from the venv. OpenCV, MMCV and setuptools
# are managed separately.
RUN grep -Eiv \
        '^[[:space:]]*(torch|torchvision|torchaudio|flash-attn|opencv-python|opencv_python|opencv-contrib-python|opencv_contrib_python|opencv-python-headless|opencv_python_headless|mmcv|setuptools)([<>=!~[:space:]]|$)' \
        "${SEEDO_ROOT}/requirements.txt" \
        > /tmp/seedo-requirements.txt \
    && python -m pip install -r /tmp/seedo-requirements.txt \
    && rm -f /tmp/seedo-requirements.txt

# MediaPipe imports TensorFlow only for optional documentation decorators.
RUN MEDIAPIPE_OPTIONAL_DEPS="$(python -c \
        'import importlib.util, os; \
         spec = importlib.util.find_spec("mediapipe"); \
         assert spec is not None and spec.origin is not None; \
         print(os.path.join(os.path.dirname(spec.origin), \
             "tasks", "python", "core", "optional_dependencies.py"))')" \
    && cat > "${MEDIAPIPE_OPTIONAL_DEPS}" <<'PY'
class _DocControls:
    @staticmethod
    def do_not_generate_docs(obj):
        return obj

    @staticmethod
    def do_not_doc_inheritable(obj):
        return obj

    @staticmethod
    def header(text):
        def decorator(obj):
            return obj
        return decorator

    @staticmethod
    def inheritable_header(text):
        def decorator(obj):
            return obj
        return decorator


doc_controls = _DocControls()
PY

RUN MEDIAPIPE_OPTIONAL_DEPS="$(python -c \
        'import importlib.util, os; \
         spec = importlib.util.find_spec("mediapipe"); \
         assert spec is not None and spec.origin is not None; \
         print(os.path.join(os.path.dirname(spec.origin), \
             "tasks", "python", "core", "optional_dependencies.py"))')" \
    && python -m py_compile "${MEDIAPIPE_OPTIONAL_DEPS}"

RUN python -m pip uninstall -y \
        opencv-python \
        opencv-contrib-python \
        opencv-python-headless \
        || true \
    && python -m pip install \
        opencv-contrib-python==4.10.0.84 \
        moviepy==1.0.3

RUN MMCV_WITH_OPS=1 \
    python -m pip install \
        --no-build-isolation \
        --no-deps \
        mmcv==2.2.0

RUN sed -i \
        -e 's/value\.type(), "ms_deform_attn_forward_cuda"/value.scalar_type(), "ms_deform_attn_forward_cuda"/' \
        -e 's/value\.type(), "ms_deform_attn_backward_cuda"/value.scalar_type(), "ms_deform_attn_backward_cuda"/' \
        "${GROUNDING_DINO_ROOT}/groundingdino/models/GroundingDINO/csrc/MsDeformAttn/ms_deform_attn_cuda.cu"

# Compile directly for NVIDIA GB10 (sm_121) with CUDA 13.
RUN cd "${GROUNDING_DINO_ROOT}" \
    && rm -rf build \
    && TORCH_CUDA_ARCH_LIST="12.1" \
       MAX_JOBS=4 \
       python setup.py build_ext --inplace

RUN python -m pip install \
        --no-build-isolation \
        --no-deps \
        "${SAM_ROOT}"

RUN SAM2_BUILD_CUDA=0 \
    python -m pip install \
        --no-build-isolation \
        --no-deps \
        "${SAM2_ROOT}"

# Preserve SeeDo's original relative paths without nesting repositories.
RUN ln -sfn "${GROUNDING_DINO_ROOT}" "${SEEDO_ROOT}/GroundingDINO" \
    && ln -sfn "${SAM_ROOT}" "${SEEDO_ROOT}/segment-anything" \
    && ln -sfn "${SAM2_ROOT}" "${SEEDO_ROOT}/segment-anything-2"

RUN if [ -f "${SEEDO_ROOT}/VLM_CaP/VideoPerception/src/vlm_perception.py" ]; then \
        sed -i \
          's/^api_key = .*/api_key = os.environ.get("OPENAI_API_KEY", "")/' \
          "${SEEDO_ROOT}/VLM_CaP/VideoPerception/src/vlm_perception.py"; \
    fi

RUN rm -rf \
        "${SEEDO_ROOT}/.git" \
        "${GROUNDING_DINO_ROOT}/.git" \
        "${SAM_ROOT}/.git" \
        "${SAM2_ROOT}/.git"

ENV UR_APPLICATION_ROOT="${ROS_WS}/src/UR5e-2f-85"

ENV PYTHONPATH="\
/opt/ros/${ROS_DISTRO}/lib/python3.12/site-packages:\
${UR_APPLICATION_ROOT}/ai_controller:\
${UR_APPLICATION_ROOT}/ai_controller/ai_controller/models/seedo_controller/models/SeeDo:\
${UR_APPLICATION_ROOT}/ai_controller/ai_controller/models/seedo_controller/models/SeeDo/VLM_CaP:\
/opt/models:\
${GROUNDING_DINO_ROOT}:\
${SAM_ROOT}:\
${SAM2_ROOT}"
WORKDIR ${ROS_WS}

RUN python -c "\
import cv2; \
import openai; \
import torch; \
import torchvision; \
import groundingdino; \
import segment_anything; \
import sam2; \
assert torch.version.cuda is not None and torch.version.cuda.startswith('13.'); \
print('SeeDo core imports OK'); \
print('torch:', torch.__version__); \
print('torchvision:', torchvision.__version__); \
print('CUDA build:', torch.version.cuda)"

RUN python -c "\
import mediapipe; \
print('MediaPipe import OK'); \
print('MediaPipe:', mediapipe.__version__)"

RUN /bin/bash -c "\
source /opt/ros/${ROS_DISTRO}/setup.bash && \
python -c 'import rclpy; \
from cv_bridge import CvBridge; \
from sensor_msgs.msg import Image; \
from vision_msgs.msg import Detection2DArray; \
print(\"ROS 2 Python imports OK\")'"

# topic_based_ros2_control for Isaac Sim integration
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    mkdir -p /opt/topic_based_ws/src && \
    git clone https://github.com/PickNikRobotics/topic_based_ros2_control.git \
        /opt/topic_based_ws/src/topic_based_ros2_control && \
    cd /opt/topic_based_ws && \
    rosdep install \
        --ignore-src \
        --from-paths src \
        -y \
        --rosdistro ${ROS_DISTRO} \
        --dependency-types build \
        --dependency-types buildtool \
        --dependency-types exec && \
    colcon build \
        --merge-install \
        --packages-select topic_based_ros2_control \
        --cmake-args -DBUILD_TESTING=OFF

COPY docker/models/seedo_ros2_entrypoint.sh /seedo_ros2_entrypoint.sh
RUN chmod +x /seedo_ros2_entrypoint.sh

ENTRYPOINT ["/seedo_ros2_entrypoint.sh"]
CMD ["bash"]
