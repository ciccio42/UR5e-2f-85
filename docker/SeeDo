# ARM64/DGX Spark port of SeeDo. The upstream baseline used CUDA 11.8 and
# PyTorch 2.3.1, which cannot target the Blackwell GPU in this system.
FROM nvidia/cuda:13.0.1-devel-ubuntu24.04

ARG SEEDO_REPOSITORY="https://github.com/InfanteAngelo/SeeDo.git"
ARG SEEDO_COMMIT="48ff18827c626c196648dc92333491c9e9dd8948"
ARG GROUNDING_DINO_REPOSITORY="https://github.com/InfanteAngelo/GroundingDINO.git"
ARG GROUNDING_DINO_COMMIT="f5e78e5e36ad3bdd50996de4f9d25e35dde8ddc9"
ARG SAM_REPOSITORY="https://github.com/facebookresearch/segment-anything.git"
ARG SAM_COMMIT="dca509fe793f601edb92606367a655c15ac00fdf"
ARG SAM2_REPOSITORY="https://github.com/facebookresearch/segment-anything-2.git"
ARG SAM2_COMMIT="2b90b9f5ceec907a1c18123530e92e794ad901a4"

LABEL org.opencontainers.image.title="SeeDo baseline"
LABEL org.opencontainers.image.description="Reproducible SeeDo environment with CUDA, PyTorch, GroundingDINO, SAM and SAM2"
LABEL org.opencontainers.image.revision="${SEEDO_COMMIT}"
LABEL com.seedo.pytorch.version="2.13.0"
LABEL com.seedo.cuda.version="13.0.1"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    SEEDO_ROOT=/home/seedo \
    VIRTUAL_ENV=/opt/seedo-venv \
    PATH=/opt/seedo-venv/bin:${PATH} \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Use an isolated Python environment and the official CUDA 13 wheels. These
# wheels support Linux ARM64 and keep torch/torchvision on matching versions.
RUN python3 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install --upgrade "pip<25" \
    && python -m pip install \
        torch==2.13.0 \
        torchvision==0.28.0 \
        torchaudio==2.13.0 \
        --index-url https://download.pytorch.org/whl/cu130

# Clone every source dependency at an immutable revision. The directory names
# intentionally match the relative paths used by SeeDo.
RUN git clone "${SEEDO_REPOSITORY}" "${SEEDO_ROOT}" \
    && git -C "${SEEDO_ROOT}" checkout --detach "${SEEDO_COMMIT}" \
    && test "$(git -C "${SEEDO_ROOT}" rev-parse HEAD)" = "${SEEDO_COMMIT}" \
    && git clone "${GROUNDING_DINO_REPOSITORY}" "${SEEDO_ROOT}/GroundingDINO" \
    && git -C "${SEEDO_ROOT}/GroundingDINO" checkout --detach "${GROUNDING_DINO_COMMIT}" \
    && test "$(git -C "${SEEDO_ROOT}/GroundingDINO" rev-parse HEAD)" = "${GROUNDING_DINO_COMMIT}" \
    && git clone "${SAM_REPOSITORY}" "${SEEDO_ROOT}/segment-anything" \
    && git -C "${SEEDO_ROOT}/segment-anything" checkout --detach "${SAM_COMMIT}" \
    && test "$(git -C "${SEEDO_ROOT}/segment-anything" rev-parse HEAD)" = "${SAM_COMMIT}" \
    && git clone "${SAM2_REPOSITORY}" "${SEEDO_ROOT}/segment-anything-2" \
    && git -C "${SEEDO_ROOT}/segment-anything-2" checkout --detach "${SAM2_COMMIT}" \
    && test "$(git -C "${SEEDO_ROOT}/segment-anything-2" rev-parse HEAD)" = "${SAM2_COMMIT}" \
    && sed -i \
        's/^api_key = .*/api_key = os.environ.get("OPENAI_API_KEY", "")/' \
        "${SEEDO_ROOT}/VLM_CaP/VideoPerception/src/vlm_perception.py" \
    && rm -rf \
        "${SEEDO_ROOT}/.git" \
        "${SEEDO_ROOT}/GroundingDINO/.git" \
        "${SEEDO_ROOT}/segment-anything/.git" \
        "${SEEDO_ROOT}/segment-anything-2/.git"

# The upstream requirements install three overlapping OpenCV wheels. They also
# pin an obsolete setuptools and build MMCV in an isolated environment where
# pkg_resources is unavailable. Install those exceptional packages explicitly.
RUN python -m pip install setuptools==69.5.1 wheel \
    && grep -Ev '^(opencv_(contrib_)?python(_headless)?|mmcv|setuptools)==' "${SEEDO_ROOT}/requirements.txt" \
        > /tmp/seedo-requirements.txt \
    && python -m pip install -r /tmp/seedo-requirements.txt \
    && python -m pip install \
        opencv-contrib-python==4.10.0.84 \
        moviepy==1.0.3 \
    && MMCV_WITH_OPS=1 python -m pip install --no-build-isolation mmcv==2.2.0

# PyTorch is installed above from the CUDA 13 wheel index. Build isolation is
# disabled so editable packages cannot replace it with another CUDA build. The SAM2
# CUDA post-processing extension is optional and is skipped for this portable
# baseline; the CUDA models themselves still run on the GPU.
RUN python -m pip install --no-build-isolation -e "${SEEDO_ROOT}/GroundingDINO" \
    && python -m pip install --no-build-isolation -e "${SEEDO_ROOT}/segment-anything" \
    && SAM2_BUILD_CUDA=0 python -m pip install --no-build-isolation -e "${SEEDO_ROOT}/segment-anything-2"

ENV PYTHONPATH="${SEEDO_ROOT}:${SEEDO_ROOT}/GroundingDINO:${SEEDO_ROOT}/segment-anything:${SEEDO_ROOT}/segment-anything-2"

WORKDIR ${SEEDO_ROOT}

# Build-time smoke test. CUDA availability is intentionally checked only when
# the container is run with --gpus, because GPUs are normally absent at build.
RUN python -c "import cv2, mediapipe, openai, torch, torchvision; import groundingdino, segment_anything, sam2; print('SeeDo imports OK'); print('torch:', torch.__version__); print('CUDA build:', torch.version.cuda)"

CMD ["bash"]
