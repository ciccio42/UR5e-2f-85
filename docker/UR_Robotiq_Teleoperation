# Docker for UR robots with Robotiq grippers and PS4 controller support on ROS 2 Jazzy
FROM ur_robotiq

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy
ENV ROS_WS=/home/ros2_ws

# Install system dependencies for PS4 controller support
RUN apt-get update && apt-get install -y \
    joystick \
    jstest-gtk \
    evtest \
    udev \
    libudev-dev \
    libhidapi-dev \
    python3-pip \
    ros-${ROS_DISTRO}-joy \
    && rm -rf /var/lib/apt/lists/*

# Optional: install ds4drv (mostly useful for Bluetooth, harmless for USB)
RUN pip3 install --no-cache-dir --break-system-packages ds4drv

# Ensure udev rules directory exists
RUN mkdir -p /etc/udev/rules.d

# Optional udev rule for PS4 controller (USB access without root)
RUN echo 'KERNEL=="js*", MODE="0666"' > /etc/udev/rules.d/99-joystick.rules && \
    echo 'KERNEL=="event*", MODE="0666"' >> /etc/udev/rules.d/99-joystick.rules

RUN apt update && apt install -y iputils-ping \
&& source /opt/ros/${ROS_DISTRO}/setup.bash \
&& colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release
RUN apt update && apt install usbutils && pip install pydualsense --break-system-packages
# Source ROS 2 automatically
RUN apt-get update && apt-get install -y ros-$ROS_DISTRO-moveit-py
RUN python3 -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128 --break-system-packages && python3 -m pip install hydra-core omegaconf einops torchsummary tqdm --break-system-packages
# Add entrypoint
COPY ./ur_robotiq_teleoperation_entrypoint.sh /ur_robotiq_teleoperation_entrypoint.sh
ENTRYPOINT ["/ur_robotiq_teleoperation_entrypoint.sh"]

# Install OpenVLA-OFT dependencies
RUN pip install peft==0.11.1 \
                accelerate==1.10.1 \
                sentencepiece==0.1.99 \
                timm==0.9.10 \
                pyyaml  \
                git+https://github.com/moojink/transformers-openvla-oft.git \
                tensorflow \
                json_numpy \
                einops  \
                packaging ninja \
                --break-system-packages

RUN apt-get install cuda-toolkit-12-8 -y
RUN update-alternatives --set cuda /usr/local/cuda-12.8
RUN pip install "flash-attn==2.5.5" \
                --no-build-isolation \
                --break-system-packages
RUN pip install --no-deps "dlimp @ git+https://github.com/moojink/dlimp_openvla" --break-system-packages
RUN pip install -U protobuf --break-system-packages
RUN pip install bitsandbytes --break-system-packages

WORKDIR ${ROS_WS}
CMD ["bash"]
