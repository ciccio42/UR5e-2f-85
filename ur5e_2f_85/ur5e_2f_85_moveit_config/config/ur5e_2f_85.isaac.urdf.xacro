<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_2f_85">

    <xacro:arg
        name="initial_positions_file"
        default="initial_positions.yaml" />

    <!-- Same robot description used by the existing MoveIt config -->
    <xacro:include
        filename="$(find ur5e_2f_85_description)/urdf/ur5e_2f_85_platform.urdf" />

    <!-- Isaac-specific ros2_control hardware interface -->
    <xacro:include
        filename="ur5e_2f_85.isaac_ros2_control.xacro" />

    <xacro:ur5e_2f_85_isaac_ros2_control
        name="IsaacSystem"
        initial_positions_file="$(arg initial_positions_file)" />

</robot>