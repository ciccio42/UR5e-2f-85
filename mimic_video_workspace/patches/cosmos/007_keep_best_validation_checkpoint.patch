+    def read_best_checkpoint_metadata(self) -> dict | None:
+        """Read the persistent best-checkpoint metric, if available."""
+        metadata_path = os.path.join(self.checkpoint_dir_local, BEST_CHECKPOINT_METADATA)
+        if not os.path.isfile(metadata_path):
+            return None
+
+        try:
+            with open(metadata_path) as file:
+                return json.load(file)
+        except (OSError, ValueError) as error:
+            log.warning(f"Could not read best-checkpoint metadata: {error}")
+            return None
+
+    def promote_best_checkpoint(self, iteration: int, val_loss: float) -> bool:
+        """Copy a complete iter checkpoint to the persistent best checkpoint."""
+        if distributed.get_rank() != 0:
+            return False
+
+        # Validation can overlap the asynchronous write of the trainer state.
+        self.finalize()
+
+        source_file = f"iter_{iteration:09}.pt"
+        best_file = f"best_{iteration:09}.pt"
+        source_paths = {
+            folder: os.path.join(self.checkpoint_dir_local, folder, source_file)
+            for folder in CHECKPOINT_FOLDERS
+        }
+        missing = [path for path in source_paths.values() if not os.path.isfile(path)]
+        if missing:
+            log.warning(
+                "Cannot promote validation checkpoint because the matching "
+                f"iteration is incomplete: {missing}"
+            )
+            return False
+
+        staged_paths: list[tuple[str, str]] = []
+        try:
+            # Stage every component before replacing or deleting any previous best.
+            for folder, source_path in source_paths.items():
+                destination = os.path.join(self.checkpoint_dir_local, folder, best_file)
+                temporary = f"{destination}.tmp"
+                shutil.copy2(source_path, temporary)
+                staged_paths.append((temporary, destination))
+
+            fused_source = os.path.join(
+                self.checkpoint_dir_local,
+                "model",
+                source_file.replace(".pt", "_fused.pt"),
+            )
+            fused_best_file = best_file.replace(".pt", "_fused.pt")
+            if os.path.isfile(fused_source):
+                fused_destination = os.path.join(self.checkpoint_dir_local, "model", fused_best_file)
+                fused_temporary = f"{fused_destination}.tmp"
+                shutil.copy2(fused_source, fused_temporary)
+                staged_paths.append((fused_temporary, fused_destination))
+
+            for temporary, destination in staged_paths:
+                os.replace(temporary, destination)
+
+            metadata = {
+                "iteration": iteration,
+                "val_loss": val_loss,
+                "filename": best_file,
+            }
+            metadata_path = os.path.join(self.checkpoint_dir_local, BEST_CHECKPOINT_METADATA)
+            metadata_temporary = f"{metadata_path}.tmp"
+            with open(metadata_temporary, "w") as file:
+                json.dump(metadata, file, indent=2)
+                file.write("\n")
+            os.replace(metadata_temporary, metadata_path)
+
+            # The new complete set and its metadata now exist: old best files are safe to remove.
+            keep_files = {best_file, fused_best_file}
+            for folder in CHECKPOINT_FOLDERS:
+                folder_path = os.path.join(self.checkpoint_dir_local, folder)
+                for filename in os.listdir(folder_path):
+                    if filename.startswith("best_") and filename.endswith(".pt") and filename not in keep_files:
+                        path = os.path.join(folder_path, filename)
+                        os.remove(path)
+                        log.info(f"Removed previous best checkpoint: {path}")
+
+            log.success(
+                f"Saved best checkpoint {best_file} with validation loss {val_loss:.8f}"
+            )
+            return True
+        except Exception as error:
+            log.exception(f"Failed to promote best checkpoint: {error}")
+            return False
+        finally:
+            for temporary, _destination in staged_paths:
+                if os.path.isfile(temporary):
+                    os.remove(temporary)
