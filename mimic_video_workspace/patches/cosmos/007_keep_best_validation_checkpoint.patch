--- /dev/null
+++ b/model/cosmos_predict2/callbacks/best_checkpoint.py
@@ -0,0 +1,86 @@
+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+from imaginaire.utils import distributed, log
+from imaginaire.utils.callback import Callback
+
+
+class BestCheckpointCallback(Callback):
+    """Keep the complete checkpoint associated with the lowest validation loss."""
+
+    def __init__(self) -> None:
+        self._best_val_loss = math.inf
+        self._val_loss_sum = 0.0
+        self._val_step_count = 0
+
+    @distributed.rank0_only
+    def on_train_start(self, model, iteration: int = 0) -> None:
+        del model, iteration
+        metadata = self.trainer.checkpointer.read_best_checkpoint_metadata()
+        if metadata is not None:
+            try:
+                self._best_val_loss = float(metadata["val_loss"])
+                log.info(
+                    "Loaded best validation loss "
+                    f"{self._best_val_loss:.8f} from {metadata.get('filename', 'unknown')}"
+                )
+            except (KeyError, TypeError, ValueError) as error:
+                log.warning(f"Ignoring invalid best-checkpoint metadata: {error}")
+
+    @distributed.rank0_only
+    def on_validation_start(self, model, dataloader_val, iteration: int = 0) -> None:
+        del model, dataloader_val, iteration
+        self._val_loss_sum = 0.0
+        self._val_step_count = 0
+
+    @distributed.rank0_only
+    def on_validation_step_end(
+        self,
+        model,
+        data_batch,
+        output_batch,
+        loss,
+        iteration: int = 0,
+    ) -> None:
+        del model, data_batch, iteration
+
+        # output_batch["loss"] is the same reduced metric logged by W&B.
+        metric = output_batch.get("loss")
+        if metric is None:
+            metric = loss.detach().float().mean()
+        if torch.is_tensor(metric):
+            metric = metric.detach().float().item()
+
+        self._val_loss_sum += float(metric)
+        self._val_step_count += 1
+
+    @distributed.rank0_only
+    def on_validation_end(self, model, iteration: int = 0) -> None:
+        del model
+        if self._val_step_count == 0:
+            log.warning("Best checkpoint was not evaluated because validation produced no batches.")
+            return
+
+        val_loss = self._val_loss_sum / self._val_step_count
+        self._val_loss_sum = 0.0
+        self._val_step_count = 0
+
+        # Iteration zero is the pretrained baseline and has no matching iter checkpoint.
+        if iteration == 0 or not math.isfinite(val_loss):
+            return
+
+        log.info(
+            f"Validation loss at iteration {iteration}: {val_loss:.8f}; "
+            f"current best: {self._best_val_loss:.8f}"
+        )
+        if val_loss >= self._best_val_loss:
+            return
+
+        if self.trainer.checkpointer.promote_best_checkpoint(iteration, val_loss):
+            self._best_val_loss = val_loss
