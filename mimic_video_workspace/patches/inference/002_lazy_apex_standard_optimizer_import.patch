# Evita di richiedere NVIDIA Apex durante la sola inferenza.
#
# La configurazione Video2World importa il factory dell'optimizer standard anche
# quando deve soltanto costruire la pipeline di inferenza. FusedAdam rimane
# disponibile per il training, ma viene importato solo quando e' effettivamente
# selezionato come optimizer.

diff --git a/model/cosmos_predict2/utils/optim_instantiate.py b/model/cosmos_predict2/utils/optim_instantiate.py
--- a/model/cosmos_predict2/utils/optim_instantiate.py
+++ b/model/cosmos_predict2/utils/optim_instantiate.py
@@ -18,7 +18,6 @@ import torch
 from torch import nn
 
 from imaginaire.utils import log
-from imaginaire.utils.fused_adam import FusedAdam
 
 
 def get_regular_param_group(net: nn.Module):
@@ -60,6 +59,8 @@ def get_base_optimizer(
     if optim_type == "adamw":
         opt_cls = torch.optim.AdamW
     elif optim_type == "fusedadam":
+        from imaginaire.utils.fused_adam import FusedAdam
+
         opt_cls = FusedAdam
     else:
         raise ValueError(f"Unknown optimizer type: {optim_type}")
