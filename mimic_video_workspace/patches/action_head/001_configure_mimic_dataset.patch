+    @staticmethod
+    def get_explicit_val_mask(
+        episode_paths: list[pathlib.Path], validation_episode_sampling: dict[str, str]
+    ) -> np.ndarray:
+        if not validation_episode_sampling:
+            raise ValueError("validation_episode_sampling cannot be empty.")
+
+        valid_sampling_modes = {"first_half", "second_half", "all"}
+        invalid_modes = set(validation_episode_sampling.values()) - valid_sampling_modes
+        if invalid_modes:
+            raise ValueError(
+                f"Invalid validation anchor sampling modes: {sorted(invalid_modes)}"
+            )
+
+        episode_indices = {path.stem: idx for idx, path in enumerate(episode_paths)}
+        if len(episode_indices) != len(episode_paths):
+            raise ValueError("Episode stems must be unique.")
+
+        requested_episodes = set(validation_episode_sampling)
+        missing_episodes = requested_episodes - set(episode_indices)
+        if missing_episodes:
+            raise ValueError(f"Validation episodes not found: {sorted(missing_episodes)}")
+
+        val_mask = np.zeros(len(episode_paths), dtype=bool)
+        for episode_stem in requested_episodes:
+            val_mask[episode_indices[episode_stem]] = True
+        return val_mask
+
     @staticmethod
