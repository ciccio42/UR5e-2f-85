             return val_mask
+        if n_val_episodes > n_episodes:
+            raise ValueError(
+                f"Cannot select {n_val_episodes} validation episodes from {n_episodes}."
+            )
 
         rng = np.random.default_rng(seed=seed)
         val_idxs = rng.choice(n_episodes, size=n_val_episodes, replace=False)
