# Registra il Cosmos UR5e fine-tuned come video backbone dell'action head.
#
# La patch:
# - aggiunge il modello Hydra "v2w_ur5e_finetuned" al catalogo dei video checkpoint;
# - legge il checkpoint reale dalla variabile UR5E_COSMOS_CKPT;
# - usa come fallback un percorso stabile dentro mimic_video_workspace/checkpoints;
# - mantiene invariati i checkpoint pretrained, Bridge e Libero degli autori;
# - permette a world2action.py di creare esperimenti UR5e che caricano questo backbone.
#
# Il launcher action head verifica l'esistenza del file prima di avviare torchrun.

diff --git a/model/cosmos_predict2/configs/defaults/world2action_model.py b/model/cosmos_predict2/configs/defaults/world2action_model.py
--- a/model/cosmos_predict2/configs/defaults/world2action_model.py
+++ b/model/cosmos_predict2/configs/defaults/world2action_model.py
@@ -14,6 +14,7 @@
