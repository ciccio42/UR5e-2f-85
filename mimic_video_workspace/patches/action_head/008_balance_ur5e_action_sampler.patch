# Bilancia il sampler del training action head sui dodici task UR5e.
#
# La patch:
# - riconosce esclusivamente MimicDataset su ur5e_pick_place_action;
# - traduce ogni indice di chunk nell'episodio proprietario tramite ChunkReader;
# - ricava il task dall'indice globale dell'episodio (40 episodi per task);
# - costruisce blocchi consecutivi di 12 chunk, uno per ciascun task;
# - mantiene la lunghezza dell'epoca vicina a quella originale;
# - ricicla deterministicamente i task con meno chunk e ruota gli altri tra le epoche;
# - conserva resume, shuffle per epoca e comportamento originale degli altri dataset;
# - non modifica il sampler di validation, che usa shuffle=False.
#
# Il training UR5e e attualmente eseguito su una sola GPU. La patch rifiuta
# esplicitamente il multi-GPU, per non promettere un bilanciamento per-rank errato.

diff --git a/model/cosmos_predict2/data/resumable_sampler.py b/model/cosmos_predict2/data/resumable_sampler.py
--- a/model/cosmos_predict2/data/resumable_sampler.py
+++ b/model/cosmos_predict2/data/resumable_sampler.py
@@ -2,6 +2,10 @@ import torch
