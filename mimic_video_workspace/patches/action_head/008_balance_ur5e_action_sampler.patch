+    def _get_ur5e_action_task_indices(self) -> list[list[int]] | None:
+        if not self._is_ur5e_action_dataset():
+            return None
+
+        chunk_reader = self.dataset._chunk_reader
+        episode_paths = chunk_reader._episode_paths
+        cumulative_timesteps = chunk_reader._cumulative_num_timesteps
+        if len(cumulative_timesteps) != len(episode_paths) + 1:
+            raise ValueError("Invalid UR5e ChunkReader episode boundaries.")
+
+        task_indices = [[] for _ in range(UR5E_NUM_TASKS)]
+        for episode_idx, episode_path in enumerate(episode_paths):
+            episode_id = episode_path.stem.removeprefix("ep_")
+            if not episode_path.stem.startswith("ep_") or not episode_id.isdigit():
+                raise ValueError(f"Unexpected UR5e action filename: {episode_path.name}")
+
+            task_id = int(episode_id) // UR5E_EPISODES_PER_TASK
+            if not 0 <= task_id < UR5E_NUM_TASKS:
+                raise ValueError(f"UR5e episode outside the expected task map: {episode_path.name}")
+
+            start = int(cumulative_timesteps[episode_idx])
+            stop = int(cumulative_timesteps[episode_idx + 1])
+            task_indices[task_id].extend(range(start, stop))
+
+        empty_tasks = [task_id for task_id, indices in enumerate(task_indices) if not indices]
+        if empty_tasks:
+            raise ValueError(f"UR5e sampler found no training chunks for tasks: {empty_tasks}")
+
+        return task_indices
