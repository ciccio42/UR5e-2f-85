+    @staticmethod
+    def _select_episode_timesteps(
+        episode_path: Path,
+        timesteps: np.ndarray | None,
+        num_timesteps: int,
+        mode: str,
+        seed: int,
+    ) -> tuple[np.ndarray | None, int]:
+        if timesteps is None or num_timesteps == 0 or mode == "all":
+            return timesteps, num_timesteps
+
+        valid_modes = {"first_half", "second_half"}
+        if mode not in valid_modes:
+            raise ValueError(f"Invalid anchor selection mode for {episode_path.stem}: {mode}")
+
+        indices = np.arange(num_timesteps)
+        first_half, second_half = np.array_split(indices, 2)
+        candidates = first_half if mode == "first_half" else second_half
+        if len(candidates) == 0:
+            candidates = indices
+
+        digest = hashlib.sha256(f"{seed}:{episode_path.stem}:{mode}".encode()).digest()
+        episode_seed = int.from_bytes(digest[:8], byteorder="little", signed=False)
+        rng = np.random.default_rng(episode_seed)
+        selected_idx = int(rng.choice(candidates))
+        return timesteps[selected_idx : selected_idx + 1], 1
