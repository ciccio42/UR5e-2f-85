# =============================================================================
# VLA-JEPA / LeRobot + ROS 2 Jazzy runtime
# NVIDIA DGX Spark / GB10 / ARM64
#
# Priorità:
#   1. Stack NVIDIA/Spark già validato
#   2. ROS 2 Jazzy + Python 3.12
#   3. PyTorch 2.8.0 + CUDA 12.9 già validato sul GB10
#   4. LeRobot
#   5. VLA-JEPA
#
# Le dipendenze di livello inferiore NON devono essere sostituite
# automaticamente durante l'installazione di LeRobot/VLA-JEPA.
# =============================================================================

FROM nvidia/cuda:12.9.2-cudnn-devel-ubuntu24.04

SHELL ["/bin/bash", "-c"]

USER root

# =============================================================================
# 1. AMBIENTE
# =============================================================================

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    ROS_DISTRO=jazzy \
    CUDA_HOME=/usr/local/cuda \
    CUDA_PATH=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="12.0+PTX" \
    VLA_JEPA_VENV=/opt/vla-jepa-ros \
    LEROBOT_SRC=/opt/lerobot \
    HF_HOME=/workspace/checkpoints/huggingface \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TOKENIZERS_PARALLELISM=false


# =============================================================================
# 2. DIPENDENZE DI SISTEMA
#
# Base derivata dal container già validato sulla DGX Spark.
# =============================================================================

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        locales \
        curl \
        ca-certificates \
        gnupg \
        lsb-release \
        software-properties-common \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        git-lfs \
        ffmpeg \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libjpeg-dev \
        libpng-dev \
    && locale-gen en_US.UTF-8 \
    && add-apt-repository universe \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*


# =============================================================================
# 3. REPOSITORY ROS 2
# =============================================================================

RUN curl -sSL \
        https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo \
        "deb [arch=$(dpkg --print-architecture) \
        signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu \
        $(. /etc/os-release && echo ${UBUNTU_CODENAME}) main" \
        > /etc/apt/sources.list.d/ros2.list


# =============================================================================
# 4. ROS 2 JAZZY
#
# Come nel runtime Interleave:
#   - NON installiamo UR driver
#   - NON installiamo ZED driver
#   - NON installiamo MoveIt completo
#
# Questi servizi continuano a girare negli altri container.
# Qui installiamo ciò che AIControllerNode deve importare/usare.
#
# NOTA:
# Usiamo python3-opencv fornito da Ubuntu/ROS, insieme a NumPy 1.26.4,
# per mantenere la compatibilità binaria con cv_bridge.
# Non installiamo opencv-python-headless tramite pip.
# =============================================================================

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base \
        ros-jazzy-rclpy \
        ros-jazzy-cv-bridge \
        ros-jazzy-message-filters \
        ros-jazzy-tf2-ros \
        ros-jazzy-sensor-msgs \
        ros-jazzy-geometry-msgs \
        ros-jazzy-control-msgs \
        ros-jazzy-action-msgs \
        ros-jazzy-ament-cmake \
        ros-jazzy-ament-cmake-python \
        ros-jazzy-rosidl-default-generators \
        ros-jazzy-rosidl-default-runtime \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        python3-opencv \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*


# =============================================================================
# 5. VENV PYTHON 3.12 PER ROS + VLA-JEPA
#
# --system-site-packages è intenzionale:
# rclpy, cv_bridge, tf2_ros ecc. vengono installati da apt e devono essere
# visibili allo stesso interprete Python che eseguirà LeRobot/VLA-JEPA.
# =============================================================================

RUN /usr/bin/python3.12 -m venv \
        --system-site-packages \
        ${VLA_JEPA_VENV}

ENV VIRTUAL_ENV=${VLA_JEPA_VENV}
ENV PATH="${VLA_JEPA_VENV}/bin:${PATH}"


# =============================================================================
# 6. CONSTRAINTS
#
# Questo file è intenzionale.
#
# Tutti i successivi pip install ricevono queste constraints, impedendo al
# resolver di sostituire silenziosamente lo stack che abbiamo scelto.
#
# PyTorch/TorchVision:
#   scelti dalla configurazione già validata sulla DGX Spark.
#
# Le altre versioni:
#   corrispondono alle versioni risolte nell'uv.lock corrente di LeRobot,
#   quando disponibili.
# =============================================================================

RUN cat > /opt/vla_jepa_constraints.txt <<'EOF'
torch==2.8.0
torchvision==0.23.0

numpy==1.26.4

Pillow==12.2.0
einops==0.8.2
draccus==0.10.0
huggingface-hub==1.14.0
requests==2.34.0
gymnasium==1.3.0
safetensors==0.7.0
packaging==25.0
termcolor==3.3.0
tqdm==4.67.3

transformers==5.5.4
diffusers==0.35.2
qwen-vl-utils==0.0.14
av==15.1.0

setuptools==80.10.2
wheel==0.45.1
EOF


# =============================================================================
# 7. PYTHON BUILD TOOLING
#
# Nessun --upgrade.
#
# Le versioni sono esplicite: non lasciamo a pip il compito di scegliere
# una nuova versione di setuptools/wheel.
# =============================================================================

RUN python -m pip install \
        --constraint /opt/vla_jepa_constraints.txt \
        setuptools==80.10.2 \
        wheel==0.45.1 \
        packaging==25.0


# =============================================================================
# 8. PYTORCH + TORCHVISION
#
# STACK PROTETTO.
#
# Questa è la combinazione già verificata sulla DGX Spark:
#
#   torch       2.8.0 + cu129
#   torchvision 0.23.0 + cu129
#   CUDA        12.9
#
# Non utilizziamo l'indice cu128 configurato dal pyproject/uv di LeRobot.
# =============================================================================

RUN python -m pip install \
        --index-url https://download.pytorch.org/whl/cu129 \
        --constraint /opt/vla_jepa_constraints.txt \
        torch==2.8.0 \
        torchvision==0.23.0


# =============================================================================
# 9. LEROBOT CORE - DIPENDENZE RUNTIME
#
# Installiamo esplicitamente le dipendenze necessarie del core LeRobot.
#
# IMPORTANTE:
# questo comando NON può cambiare torch/torchvision/numpy/opencv perché
# sono protetti dal constraint file.
#
# Non installiamo:
#   dataset
#   training
#   hardware
#   viz
#   libero
#   metaworld
#   accelerate
#   wandb
#   torchcodec
#   ecc.
# =============================================================================

RUN python -m pip install \
        --constraint /opt/vla_jepa_constraints.txt \
        numpy==1.26.4 \
        Pillow==12.2.0 \
        einops==0.8.2 \
        draccus==0.10.0 \
        huggingface-hub==1.14.0 \
        requests==2.34.0 \
        gymnasium==1.3.0 \
        safetensors==0.7.0 \
        packaging==25.0 \
        termcolor==3.3.0 \
        tqdm==4.67.3


# =============================================================================
# 10. VLA-JEPA
#
# Versioni prese dalla configurazione/lockfile corrente di LeRobot.
#
# qwen-vl-utils dipende anche da PyAV; lo installiamo esplicitamente per
# evitare che venga scelta in futuro una release differente.
# =============================================================================

RUN python -m pip install \
        --constraint /opt/vla_jepa_constraints.txt \
        transformers==5.5.4 \
        diffusers==0.35.2 \
        qwen-vl-utils==0.0.14 \
        av==15.1.0


# =============================================================================
# 11. COPIA DEL SUBMODULE LEROBOT
#
# Build context previsto:
#
# ai_controller/ai_controller/models/vla_jepa_controller/
#
# con:
#
# external/lerobot/
# Docker/Dockerfile.vla-jepa
# =============================================================================

COPY external/lerobot ${LEROBOT_SRC}


# =============================================================================
# 12. INSTALLAZIONE LEROBOT
#
# --no-deps:
#   fondamentale. Abbiamo già installato manualmente lo stack desiderato.
#   Il pyproject di LeRobot NON deve avere la possibilità di sostituire
#   PyTorch cu129 con la configurazione cu128 del progetto.
#
# --no-build-isolation:
#   evita anche di creare un ambiente temporaneo che scarichi
#   automaticamente una diversa versione di setuptools.
# =============================================================================

RUN python -m pip install \
        --editable ${LEROBOT_SRC} \
        --no-deps \
        --no-build-isolation


# =============================================================================
# 13. DIRECTORY RUNTIME
# =============================================================================

RUN mkdir -p \
        /home/ros2_ws/src \
        /workspace \
        /workspace/checkpoints


# =============================================================================
# 14. SETUP RUNTIME
# =============================================================================

RUN cat > ${VLA_JEPA_VENV}/setup_runtime.sh <<'EOF'
#!/usr/bin/env bash

# ROS Jazzy
source /opt/ros/jazzy/setup.bash

# Python 3.12 ROS + LeRobot/VLA-JEPA
source /opt/vla-jepa-ros/bin/activate

# CUDA / DGX Spark
export CUDA_HOME=/usr/local/cuda
export CUDA_PATH=/usr/local/cuda
export TORCH_CUDA_ARCH_LIST="12.0+PTX"

# Hugging Face cache
export HF_HOME=/workspace/checkpoints/huggingface

# Workspace ROS compilato
if [[ -f /home/ros2_ws/install/setup.bash ]]; then
    source /home/ros2_ws/install/setup.bash
fi
EOF

RUN chmod +x ${VLA_JEPA_VENV}/setup_runtime.sh


# =============================================================================
# 15. BUILD-TIME SMOKE TEST
#
# Durante docker build non assumiamo che la GPU sia disponibile.
#
# Verifichiamo però:
#   - Python 3.12
#   - ROS nello stesso interprete
#   - conversione reale NumPy <-> cv_bridge
#   - stack PyTorch cu129
#   - LeRobot
#   - moduli VLA-JEPA
#
# Il caricamento del vero checkpoint verrà testato successivamente sulla
# Spark con GPU disponibile.
# =============================================================================

RUN source /opt/ros/jazzy/setup.bash && \
    source ${VLA_JEPA_VENV}/bin/activate && \
    python - <<'PY'
import sys
import platform

assert sys.version_info[:2] == (3, 12), sys.version
assert platform.machine() == "aarch64", platform.machine()

# ------------------------------------------------------------------
# ROS
# ------------------------------------------------------------------
import rclpy
import cv_bridge
import message_filters
import tf2_ros

from sensor_msgs.msg import Image, JointState
from control_msgs.action import GripperCommand

# ------------------------------------------------------------------
# NumPy / OpenCV
# ------------------------------------------------------------------
import numpy as np
import cv2

assert np.__version__ == "1.26.4", np.__version__

print("OpenCV:", cv2.__version__)

# Verifica concreta cv_bridge <-> NumPy.
bridge = cv_bridge.CvBridge()

image_np = np.zeros((16, 16, 3), dtype=np.uint8)
image_msg = bridge.cv2_to_imgmsg(image_np, encoding="bgr8")
image_back = bridge.imgmsg_to_cv2(image_msg, desired_encoding="bgr8")

assert image_back.shape == image_np.shape
assert np.array_equal(image_back, image_np)

# ------------------------------------------------------------------
# ML stack
# ------------------------------------------------------------------
import torch
import torchvision
import transformers
import diffusers
import av
import qwen_vl_utils

assert torch.__version__.startswith("2.8.0"), torch.__version__
assert torch.version.cuda == "12.9", torch.version.cuda
assert torchvision.__version__.startswith("0.23.0"), torchvision.__version__
assert transformers.__version__ == "5.5.4", transformers.__version__
assert diffusers.__version__ == "0.35.2", diffusers.__version__

# ------------------------------------------------------------------
# LeRobot / VLA-JEPA
# ------------------------------------------------------------------
import lerobot

from lerobot.policies.vla_jepa.configuration_vla_jepa import VLAJEPAConfig
from lerobot.policies.vla_jepa.modeling_vla_jepa import VLAJEPAPolicy
from lerobot.policies.vla_jepa.processor_vla_jepa import (
    make_vla_jepa_pre_post_processors,
)

print()
print("============================================================")
print(" VLA-JEPA / LeRobot ROS runtime")
print("============================================================")
print(f"Architecture:    {platform.machine()}")
print(f"Python:          {sys.version.split()[0]}")
print(f"PyTorch:         {torch.__version__}")
print(f"PyTorch CUDA:    {torch.version.cuda}")
print(f"TorchVision:     {torchvision.__version__}")
print(f"NumPy:           {np.__version__}")
print(f"OpenCV:          {cv2.__version__}")
print(f"Transformers:    {transformers.__version__}")
print(f"Diffusers:       {diffusers.__version__}")
print(f"PyAV:            {av.__version__}")
print("rclpy:           OK")
print("cv_bridge:       OK")
print("LeRobot:         OK")
print("VLA-JEPA:        OK")
print("============================================================")
print()
PY


# =============================================================================
# 16. DEFAULT RUNTIME
# =============================================================================

WORKDIR /home/ros2_ws

ENTRYPOINT []

CMD ["/bin/bash"]